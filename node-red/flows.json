e":"function 6","func":"var rows = msg.payload;\n\nif (Array.isArray(rows) && rows.length > 0) {\n    var chartData = [];\n    \n    rows.forEach(function(row) {\n        // Gunakan objek Date langsung agar Dashboard membaca format waktunya dengan benar\n        var waktu = row.ts ? new Date(row.ts.replace(' ', 'T')) : new Date();\n        \n        if (row.room1 !== null && row.room1 !== undefined) {\n            chartData.push({ topic: \"Room 1\", payload: Number(row.room1), timestamp: waktu });\n        }\n        if (row.room2 !== null && row.room2 !== undefined) {\n            chartData.push({ topic: \"Room 2\", payload: Number(row.room2), timestamp: waktu });\n        }\n        if (row.room3 !== null && row.room3 !== undefined) {\n            chartData.push({ topic: \"Room 3\", payload: Number(row.room3), timestamp: waktu });\n        }\n        if (row.room4 !== null && row.room4 !== undefined) {\n            chartData.push({ topic: \"Room 4\", payload: Number(row.room4), timestamp: waktu });\n        }\n    });\n    \n    msg.payload = chartData;\n    return msg;\n}\n\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":780,"y":1320,"wires":[["8c0968c60261135c"]]},{"id":"8c0968c60261135c","type":"debug","z":"c915d9adf1b22f2c","name":"debug 6","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":920,"y":1320,"wires":[]},{"id":"5ffb5e42d92459f5","type":"sqlite","z":"c915d9adf1b22f2c","mydb":"022099c724f82c31","sqlquery":"prepared","sql":"SELECT ts, temperature, room\nFROM sensor_data\nWHERE ts >= $sejak\nORDER BY ts;","name":"Kueri Historis","x":670,"y":1380,"wires":[["6c3e263676ab73c6","961d1806ca8a0a8c"]]},{"id":"61357cab90bf523f","type":"function","z":"c915d9adf1b22f2c","name":"function 7","func":"// SQL untuk membuat tabel dan indeks (aman dijalankan berulang kali)\nmsg.topic = `\nCREATE TABLE IF NOT EXISTS sensor_data  (\n    